# SSC API origin (no trailing slash). APIs live at /api and /api/admin.
# Frontend UI is at https://ssc.mengfei.tech/super-supply-chain/ — do not append that path here.
SSC_BASE_URL=https://ssc.mengfei.tech

# Prefer a pre-issued JWT (from UI login or `ssc login` CLI). Do not commit real tokens.
# SSC_TOKEN=

# Or username/password so the MCP server can call POST /api/login on demand.
# SSC_USERNAME=testuser
# SSC_PASSWORD=

# MCP transport. Omit or set stdio for Cursor's local command config.
# http serves Streamable HTTP at /mcp and legacy SSE at /sse.
# SSC_MCP_TRANSPORT=stdio
# SSC_MCP_HOST=0.0.0.0
# SSC_MCP_PORT=3100
# Browser clients: * allows any Origin. Or a comma-separated allow-list.
# SSC_MCP_CORS_ORIGIN=*
# Optional Host allow-list when binding 0.0.0.0 (DNS rebinding protection).
# SSC_MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional directory for ssc_export_excel downloads. Default: OS temp dir / ssc-mcp-exports.
# SSC_EXPORT_DIR=
