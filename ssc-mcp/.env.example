# SSC API origin (no trailing slash). APIs live at /api and /api/admin.
# Frontend UI is at https://ssc.mengfei.tech/super-supply-chain/ — do not append that path here.
SSC_BASE_URL=https://ssc.mengfei.tech

# Prefer a pre-issued JWT (from UI login or `ssc login` CLI). Do not commit real tokens.
# SSC_TOKEN=

# Or username/password so the MCP server can call POST /api/login on demand.
# SSC_USERNAME=testuser
# SSC_PASSWORD=
